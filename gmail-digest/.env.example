# Anthropic API key used to generate the summary
ANTHROPIC_API_KEY=

# Google OAuth credentials — create these in Google Cloud Console:
# 1. https://console.cloud.google.com/ -> create/select a project
# 2. Enable the "Gmail API" (APIs & Services -> Library)
# 3. APIs & Services -> Credentials -> Create Credentials -> OAuth client ID
#    - Application type: Web application
#    - Authorized redirect URI: http://localhost:3002/auth/google/callback
# 4. Copy the generated Client ID / Client Secret below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3002/auth/google/callback

PORT=3002
